# Database Connection
# You can supply a full connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geek_calendar

# Or configure discrete PostgreSQL connection variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=geek_calendar
# PGSSL=false

# Application Server
PORT=3000
NODE_ENV=development

# Third-Party Provider Credentials
TMDB_API_KEY=your_tmdb_api_key_here
IGDB_CLIENT_ID=your_twitch_igdb_client_id_here
IGDB_CLIENT_SECRET=your_twitch_igdb_client_secret_here
