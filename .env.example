# Database Connection
# You can supply a full connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geek_calendar

# Or configure discrete PostgreSQL connection variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=geek_calendar
# PGSSL=false

# Application Server
PORT=3000
NODE_ENV=development

# Third-Party Provider Credentials
FRONTEND_ORIGIN=https://your-frontend-domain.example
TMDB_API_KEY=your_tmdb_api_key_here
IGDB_CLIENT_ID=your_twitch_igdb_client_id_here
IGDB_CLIENT_SECRET=your_twitch_igdb_client_secret_here
# MangaDex is public and does not require a credential.
# GCD is public and does not require a credential. Override only for testing.
# GCD_API_BASE_URL=https://www.comics.org/api
